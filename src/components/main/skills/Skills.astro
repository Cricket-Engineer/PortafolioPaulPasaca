---
import { skills } from "../../../const/const";
import { getIconComponent } from "../../../icons/IconAll.astro";
---

<section class="section-skill">
  <div class="linear-gradient-2"></div>
  <div class="linear-gradient-1"></div>
  <div class="container-skill">
    <h2 class="title-skills" id="skills">HABILIDADES</h2>
    <ul class="ul-skill">
      {
        skills.map(({ icon, title }) => {
          const IconComponent = getIconComponent(icon);
          return (
            <li class="li-skills">
              {IconComponent && <IconComponent />}
              <p class="p-skill">{title}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>

   .linear-gradient-1 {
    position: absolute;
    left: 0;
    top: 0;
    width: 80%;
    height: 80%;
    background: radial-gradient(
      at left center,
      rgba(1, 190, 150, 0.3),
      transparent,
      transparent
    );
    z-index: 0;
  }
  .linear-gradient-2 {
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      at right center,
      rgba(31, 58, 147, 0.3),
    transparent,
    transparent
    );
    z-index: 0;
  }
  .section-skill {
    position: relative;
    overflow: hidden;
    background: #F6F6F9;
    padding: 25px 0;
  }
  .section-skill::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  height: 2px;
  width: 100%;
  background: linear-gradient(to right, transparent, #4872ff, transparent);
  pointer-events: none;
}
  .container-skill {
    position: relative;
    width: 90%;
    color: #6E7A8A;
    margin: 0 auto;
    max-width: 1355px;
    z-index: 1;
  }
  .title-skills {
    position: relative;
    display: block;
    font-size: 30px;
    padding: 10px 0;
    color: #1F3A93;;
    width: 100%;
    font-weight: 800;
    scroll-margin-top: 80px;
    text-align: center;
    margin-bottom: 25px;
  }

  .li-skills {
    list-style: none;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #6E7A8A;
    border-radius: 12px;
    padding: 20px 10px;
    text-align: center;
    transition: all 0.3s ease-in-out;
  }
  
  .li-skills:hover {
    transform: translateY(-6px);
    border-color: #01BE96;
    box-shadow: 0 6px 15px rgba(1, 190, 150, 0.3);
  }

  .p-skill {
    padding: 8px 0;
    font-size: 14px;
    color: #6E7A8A;
  }
  .linear-grandient-1 {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      at right center,
      rgba(31, 58, 147, 0.3),
    transparent,
    transparent
    );    
    z-index: 0;
  }

  .ul-skill {
    position: relative;
    display: grid;
    width: 100%;
    align-items: center;
    gap: 15px;
    padding: 40px 0;
    width: 100%;
    overflow: hidden;
    grid-template-columns: repeat(8, 1fr);
  }
  @media (min-width: 300px) {
    .ul-skill {
      grid-template-columns: repeat(3, 1fr);
      padding: 20px 0;
    }
  }
  @media (min-width: 550px) {
    .ul-skill {
      grid-template-columns: repeat(4, 1fr);
      padding: 20px 0;
    }
  }
  @media (min-width: 800px) {
    .ul-skill {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .ul-skill {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .ul-skill {
      grid-template-columns: repeat(7, 1fr);
    }
  }
  @media (min-width: 1350px) {
    .ul-skill {
      grid-template-columns: repeat(8, 1fr);
    }
  }
</style>
