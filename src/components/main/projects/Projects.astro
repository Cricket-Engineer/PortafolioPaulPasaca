---
import { projects } from "../../../const/const";
import Project from "./Project.astro";
---

<section class="section-projects">
  <div class="linear-gradient-2"></div>
  <div class="linear-gradient-1"></div>
  <div class="container-projects">
    <h2 class="title-projects" id="proyectos">PROYECTOS</h2>
    <div>
      <ul class="ul-projects">
        {
          projects.map(({ description, img, link, technologies, title }) => (
            <Project
              img={img}
              description={description}
              link={link}
              title={title}
              technologies={technologies}
            />
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  
  .linear-gradient-1 {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      at left center,
      rgba(1, 190, 150, 0.3),
      transparent,
      transparent
    );
    z-index: 0;
  }
  .linear-gradient-2 {
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      at right center,
      rgba(31, 58, 147, 0.3),
    transparent,
    transparent
    );
    z-index: 0;
  }

  .section-projects {
    position: relative;
    background-color: #F6F6F9;
    overflow: hidden;
  }
  .section-projects::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  height: 1px;
  width: 100%;
  background: linear-gradient(to right, transparent, #4872ff, transparent);
  pointer-events: none;
  }

  .container-projects {
    position: relative;
    width: 90%;
    margin: 0 auto;
    max-width: 1355px;
  }
  .title-projects {
    position: relative;
    display: block;
    font-size: 30px;
    padding: 30px 0;
    color: #1F3A93;
    width: 100%;
    font-weight: 800;
    scroll-margin-top: 80px;
    text-align: center;
  }

  .ul-projects {
    position: relative;
    display: grid;
    place-items: center;
    padding: 40px 0;
    width: 100%;
    height: 100%;
  }
  .ul-projects a {
    text-decoration: none;
    color: #01BE96; /* Verde del resto de la web */
    font-weight: 600;
    transition: 0.3s;
  }
   .ul-projects a:hover {
    color: #585d0f; /* Verde más oscuro en hover */
  }

  /* responsive */

  @media (min-width: 300px) {
    .ul-projects {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }
  @media (min-width: 700px) {
    .ul-projects {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }
  @media (min-width: 1200px) {
    .ul-projects {
      grid-template-columns: repeat(3, 1fr);
      justify-content: space-between;
    }
  }
</style>
