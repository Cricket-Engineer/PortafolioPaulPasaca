---
// IconNumpy.astro
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="12 6 56 56" width="45" height="45" 
aria-label="NumPy logo" role="img"
style="cursor: pointer;"
>
  <!-- Tooltip al pasar el ratón -->
  <title>Numpy</title>

  <defs>
    <linearGradient id="frontFace" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4D77CF"/>
      <stop offset="1" stop-color="#306998"/>
    </linearGradient>
    <linearGradient id="sideFace" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5A8FD8"/>
      <stop offset="1" stop-color="#2A4C9C"/>
    </linearGradient>
    <linearGradient id="topFace" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7FA8FF"/>
      <stop offset="1" stop-color="#4D77CF"/>
    </linearGradient>
  </defs>

  <!-- Cubo centrado y más bajo -->
  <g transform="scale(1.3) translate(-12, -2)">
    <!-- Cara superior -->
    <polygon points="20,12 52,12 60,20 28,20" fill="url(#topFace)" stroke="#1a2a6c" stroke-width="1"/>
    <!-- Cara frontal -->
    <polygon points="28,20 60,20 60,44 28,44" fill="url(#frontFace)" stroke="#1a2a6c" stroke-width="1"/>
    <!-- Cara izquierda -->
    <polygon points="20,12 28,20 28,44 20,36" fill="url(#sideFace)" stroke="#1a2a6c" stroke-width="1"/>

    <!-- Cuadrícula frontal -->
    <g stroke="#ffffff" stroke-width="0.6" opacity="0.7">
      <line x1="36" y1="20" x2="36" y2="44"/>
      <line x1="44" y1="20" x2="44" y2="44"/>
      <line x1="52" y1="20" x2="52" y2="44"/>
      <line x1="28" y1="28" x2="60" y2="28"/>
      <line x1="28" y1="36" x2="60" y2="36"/>
    </g>

    <!-- Letra N -->
    <text x="21" y="34" font-size="12" font-family="Arial Black, sans-serif"
          fill="#ffffff" font-weight="bold" transform="rotate(-6, 22, 34)">
      N
    </text>
  </g>
</svg>
