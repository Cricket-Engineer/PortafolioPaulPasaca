---
/* IconJupyter.astro */
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="45px" height="45px" aria-label="Jupyter">
  <!-- anillo elíptico (dos arcos) -->
  <defs>
    <linearGradient id="jupOrange" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#F37726"/>
      <stop offset="1" stop-color="#E56C1A"/>
    </linearGradient>
  </defs>

  <!-- arco superior -->
  <path
    d="M10,20
       C10,12 18,8 24,8
       C30,8 38,12 38,20"
    fill="none"
    stroke="url(#jupOrange)"
    stroke-width="6"
    stroke-linecap="round"
  />
  <!-- arco inferior -->
  <path
    d="M38,28
       C38,36 30,40 24,40
       C18,40 10,36 10,28"
    fill="none"
    stroke="url(#jupOrange)"
    stroke-width="6"
    stroke-linecap="round"
  />

  <!-- puntos grises característicos -->
  <circle cx="12" cy="5" r="1.6" fill="#4E4E4E"/>
  <circle cx="39" cy="3" r="2.5" fill="#4E4E4E"/>

  <circle cx="10" cy="44" r="3.1" fill="#4E4E4E"/>
</svg>
