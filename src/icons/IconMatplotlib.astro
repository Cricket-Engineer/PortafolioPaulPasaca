---
/* No necesitas lógica en el frontmatter para este ícono */
---

<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" width="45px" height="45px" role="img" 
aria-label="Polar bar chart icon" style="cursor: pointer;"
>
  
  <title>Matplotlib</title>

  <circle cx="100" cy="100" r="90" fill="#f9f9f9" stroke="#ccc" stroke-width="1" />
  
  <!-- Barras radiales -->
  <g transform="translate(100,100)">
    <g transform="rotate(0)">
      <rect x="0" y="-5" width="60" height="10" fill="#fca311" rx="2" />
    </g>
    <g transform="rotate(45)">
      <rect x="0" y="-5" width="50" height="10" fill="#ffd60a" rx="2" />
    </g>
    <g transform="rotate(90)">
      <rect x="0" y="-5" width="70" height="10" fill="#2ec4b6" rx="2" />
    </g>
    <g transform="rotate(135)">
      <rect x="0" y="-5" width="40" height="10" fill="#3a86ff" rx="2" />
    </g>
    <g transform="rotate(180)">
      <rect x="0" y="-5" width="55" height="10" fill="#ff006e" rx="2" />
    </g>
    <g transform="rotate(225)">
      <rect x="0" y="-5" width="35" height="10" fill="#8338ec" rx="2" />
    </g>
    <g transform="rotate(270)">
      <rect x="0" y="-5" width="65" height="10" fill="#06d6a0" rx="2" />
    </g>
    <g transform="rotate(315)">
      <rect x="0" y="-5" width="45" height="10" fill="#ef476f" rx="2" />
    </g>
  </g>

  <!-- Líneas circulares -->
  <circle cx="100" cy="100" r="30" stroke="#ddd" stroke-width="0.5" fill="none" />
  <circle cx="100" cy="100" r="60" stroke="#ddd" stroke-width="0.5" fill="none" />
  <circle cx="100" cy="100" r="90" stroke="#ddd" stroke-width="0.5" fill="none" />
</svg>
