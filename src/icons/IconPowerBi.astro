<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width="45px" 
  height="45px"
style="cursor: pointer;"

>
  <title>PowerBi</title>
  <!-- Barra 1 (más pequeña, tono más tomate oscuro) -->
  <rect x="6" y="32" width="6" height="10" fill="#d35400" rx="1"/>

  <!-- Barra 2 (un poco más alta, tono mostaza oscuro) -->
  <rect x="14" y="26" width="6" height="16" fill="#e67e22" rx="1"/>

  <!-- Barra 3 (más grande, tono intermedio entre amarillo y tomate) -->
  <rect x="22" y="18" width="6" height="24" fill="#f39c12" rx="1"/>

  <!-- Barra 4 (la más grande de todas, amarillo Power BI puro) -->
  <rect x="30" y="8" width="6" height="34" fill="#f2c811" rx="1"/>
</svg>
